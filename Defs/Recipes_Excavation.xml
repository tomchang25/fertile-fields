<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Excavation recipes — no input ingredients, Mining skill -->

	<!-- Clay -->

	<RecipeDef>
		<defName>RFF_ExcavateClay</defName>
		<label>excavate clay x3</label>
		<description>Dig up clay from the earth.</description>
		<jobString>Excavating clay.</jobString>
		<workSkillLearnFactor>0.25</workSkillLearnFactor>
		<effectWorking>CutStone</effectWorking>
		<soundWorking>Recipe_MakeStoneBlocks</soundWorking>
		<workAmount>600</workAmount>
		<products>
			<RFFClay>3</RFFClay>
		</products>
		<workSkill>Mining</workSkill>
	</RecipeDef>

	<RecipeDef>
		<defName>RFF_ExcavateClayBulk</defName>
		<label>excavate clay x15</label>
		<description>Dig up a large amount of clay from the earth.</description>
